# Runtime mode: development | test | production
NODE_ENV=development
# HTTP port for the API and Socket.io server
PORT=5000
# MongoDB connection string (local or Atlas). MongoDB 6+ is required.
MONGODB_URI=mongodb://127.0.0.1:27017/repairhub
# Frontend origin(s) allowed by CORS and Socket.io; comma-separate several (no trailing slash)
CLIENT_URL=http://localhost:5173
# Secret for signing access tokens: 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-48-random-bytes-hex
# Secret for signing refresh tokens: 32+ chars and DIFFERENT from JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=replace-with-a-different-48-random-bytes-hex
# Access token lifetime (number + s|m|h|d)
JWT_ACCESS_EXPIRES=15m
# Refresh token lifetime (number + s|m|h|d); also used as the refresh cookie max age
JWT_REFRESH_EXPIRES=7d
# true sends the refresh cookie only over HTTPS (set true in production)
COOKIE_SECURE=false
# true when running behind Nginx or a load balancer (real client IP for rate limits, secure cookies)
TRUST_PROXY=false
# true makes Express serve frontend/dist (always on when NODE_ENV=production)
SERVE_FRONTEND=false
# Map tile origins allowed by the Content-Security-Policy, comma-separated
MAP_TILE_ORIGINS=https://tile.openstreetmap.org,https://*.tile.openstreetmap.org
# Hard upper limit for technician matching radius, in kilometres
MAX_DISPATCH_RADIUS_KM=25
# Service radius given to new technician profiles, in kilometres (1-50)
DEFAULT_SERVICE_RADIUS_KM=10
# How many schedule proposals a technician may make for one booking
MAX_PROPOSAL_ROUNDS=3
# Maximum images per upload request
UPLOAD_MAX_FILES=5
# Maximum size of a single uploaded image, in megabytes
UPLOAD_MAX_MB=5
# ISO 4217 currency code; amounts are whole units of this currency
CURRENCY=NPR
# Seed data centre latitude (Kathmandu)
SEED_CENTER_LAT=27.7172
# Seed data centre longitude (Kathmandu)
SEED_CENTER_LNG=85.3240
