# Base URL of the REST API. Keep /api in development so the Vite proxy is used.
VITE_API_URL=/api
# Socket.io server origin. "/" means the same origin (Vite proxies /socket.io in development).
VITE_SOCKET_URL=/
# ISO 4217 currency shown for prices (must match the backend CURRENCY)
VITE_CURRENCY=NPR
# Default map centre (Kathmandu)
VITE_MAP_DEFAULT_LAT=27.7172
VITE_MAP_DEFAULT_LNG=85.3240
# Map tile URL template (OpenStreetMap needs no API key)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
