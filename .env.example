# Variables for docker compose (copy to .env next to docker-compose.yml).
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-48-random-bytes-hex
JWT_REFRESH_SECRET=replace-with-a-different-48-random-bytes-hex
# Leave empty to use the bundled mongo service, or set an Atlas URI.
MONGODB_URI=
# Public origin(s) of the app, comma-separated (must match the browser URL exactly).
CLIENT_URL=http://localhost:5000
# true when served over HTTPS (behind Nginx with TLS)
COOKIE_SECURE=false
# true when behind Nginx / a load balancer
TRUST_PROXY=false
# Host port for the app
APP_PORT=5000
