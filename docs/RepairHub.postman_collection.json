{
  "info": {
    "name": "RepairHub API (Phase 2)",
    "description": "Run \"npm run seed -w backend -- --reset\" first. Folders follow the booking flow. Login requests store tokens in collection variables; \"Create booking\" stores {{bookingId}}. The technician used is Bikash (AC, Koteshwor), who can reach New Baneshwor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "password",
      "value": "Password@123"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "techToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "technicianUserId",
      "value": ""
    },
    {
      "key": "in2h",
      "value": ""
    },
    {
      "key": "in5h",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const inMinutes = (m) => new Date(Date.now() + m * 60000).toISOString();",
          "pm.collectionVariables.set('in2h', inMinutes(120));",
          "pm.collectionVariables.set('in5h', inMinutes(300));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Categories (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login customer (Sita)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sita@repairhub.test\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.collectionVariables.set('customerToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login technician (Bikash)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bikash@repairhub.test\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.collectionVariables.set('techToken', pm.response.json().data.accessToken);",
                  "pm.collectionVariables.set('technicianUserId', pm.response.json().data.user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@repairhub.test\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
