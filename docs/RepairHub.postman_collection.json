    {
      "name": "1. Customer creates a request",
      "item": [
        {
          "name": "Create booking (JSON; use form-data with \"images\" for photos)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"AC\",\n  \"title\": \"AC not cooling, rattling noise\",\n  \"description\": \"Bedroom split AC blows warm air and rattles loudly.\",\n  \"lng\": 85.342,\n  \"lat\": 27.6915,\n  \"addressText\": \"New Baneshwor, Kathmandu, near Everest Hotel\",\n  \"urgency\": \"NORMAL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.collectionVariables.set('bookingId', pm.response.json().data.booking._id);",
                  "pm.test('matchedCount present', () => pm.expect(pm.response.json().data).to.have.property('matchedCount'));"
                ]
              }
            }
          ]
        },
        {
          "name": "My bookings (active)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
