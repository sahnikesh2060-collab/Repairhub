              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/my?status=active",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "my"],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
